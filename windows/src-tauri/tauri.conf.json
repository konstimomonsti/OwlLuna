{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OwlLuna",
  "version": "0.1.0",
  "identifier": "io.github.owlluna.windows",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "OwlLuna",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 520,
        "dragDropEnabled": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "shortDescription": "Handwritten notes",
    "longDescription": "OwlLuna for Windows. Free, open-source handwritten notes. An unofficial port of the iPad app.",
    "copyright": "MIT License",
    "windows": {
      "nsis": { "installMode": "currentUser" }
    }
  }
}
